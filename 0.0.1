// 独占渲染：全三大难度综合排行榜大看板
void DrawLeaderboardScreen(int mx, int my) {
    setbkcolor(C_BG);
    cleardevice();

    settextcolor(C_TEXT_TITLE);
    settextstyle(42, 0, L"微软雅黑");
    const wchar_t* title = L"🏆 荣 誉 排 行 榜 🏆";
    outtextxy((WIN_W - textwidth(title)) / 2, 35, title);

    const wchar_t* diffLabels[] = { L"简单模式 (3x3)", L"普通模式 (4x4)", L"困难模式 (5x5)" };
    int colW = 260; 
    int startX = 45;
    int gapX = 30;
    int startY = 115;

    for (int d = 0; d < 3; d++) {
        int cx = startX + d * (colW + gapX);
        
        // 模块卡片底色
        setfillcolor(RGB(22, 26, 40));
        solidroundrect(cx, startY, cx + colW, startY + 390, 12, 12);
        setlinecolor(RGB(55, 62, 82));
        roundrect(cx, startY, cx + colW, startY + 390, 12, 12);

        // 模块小标题
        settextcolor(RGB(150, 200, 255));
        settextstyle(21, 0, L"微软雅黑");
        outtextxy(cx + (colW - textwidth(diffLabels[d])) / 2, startY + 15, diffLabels[d]);

        // 分割线
        line(cx + 15, startY + 50, cx + colW - 15, startY + 50);

        // 列头说明
        settextstyle(14, 0, L"微软雅黑");
        settextcolor(C_TEXT_SUB);
        outtextxy(cx + 15, startY + 60, L"排名   账号昵称");
        outtextxy(cx + 165, startY + 60, L"成绩(步/秒)");

        // 循环绘制Top5选手
        for (int i = 0; i < BOARD_SIZE; i++) {
            int rY = startY + 95 + i * 56;
            wchar_t rankBuf[10];
            swprintf_s(rankBuf, _countof(rankBuf), L"No.%d", i + 1);

            // 前三名分配金银铜色高亮
            if (i == 0)      settextcolor(RGB(255, 215, 0));
            else if (i == 1) settextcolor(RGB(198, 198, 198));
            else if (i == 2) settextcolor(RGB(186, 110, 64));
            else             settextcolor(WHITE);

            settextstyle(18, 0, L"微软雅黑");
            outtextxy(cx + 15, rY, rankBuf);

            if (g_boards[d][i].steps == -1) {
                settextcolor(C_SCORE_NONE);
                outtextxy(cx + 70, rY, L"虚位以待");
            } else {
                // 绘制账号昵称
                settextstyle(17, 0, L"微软雅黑");
                outtextxy(cx + 70, rY, g_boards[d][i].account);
                
                // 绘制成绩
                wchar_t scoreBuf[40];
                swprintf_s(scoreBuf, _countof(scoreBuf), L"%d步 / %d秒", g_boards[d][i].steps, g_boards[d][i].timeUsed);
                settextstyle(15, 0, L"Arial");
                outtextxy(cx + 165, rY, scoreBuf);
            }
        }
    }

    // 底部返回按钮
    int btnW = 180, btnH = 45;
    int btnX = (WIN_W - btnW) / 2;
    int btnY = WIN_H - 85;
    bool hover = IsInRect(mx, my, btnX, btnY, btnW, btnH);
    DrawButton(btnX, btnY, btnW, btnH, L"返回主菜单", hover, C_BTN, C_BTN_HOVER, C_BTN_BORDER);

    settextcolor(C_TEXT_SUB);
    settextstyle(14, 0, L"微软雅黑");
    const wchar_t* escTip = L"快捷键提示：在任意非游戏界面按 ESC 均可退回主页面";
    outtextxy((WIN_W - textwidth(escTip)) / 2, btnY + 55, escTip);
}

// ============================================================
//  程序主引擎入口
// ============================================================
int main() {
    initgraph(WIN_W, WIN_H);
    SetWindowTextW((HWND)GetHWnd(), L"翻翻乐 - 带本地持久化排行榜系统");
    BeginBatchDraw();
    setbkcolor(C_BG);
    cleardevice();
    
    LoadLeaderboard(); // 读取本地持久化排行榜

    g_phase = PHASE_MENU;
    g_mouseX = 0;  g_mouseY = 0;

    while (true) {
        // -------- 键盘宏监听响应 --------
        if (GetAsyncKeyState(VK_ESCAPE) & 0x8000) {
            Sleep(160);
            if (g_phase == PHASE_MENU) {
                break; // 菜单下按ESC完全退出
            } else if (g_phase == PHASE_LEADERBOARD) {
                g_phase = PHASE_MENU; // 退出排行榜
                continue;
            } else {
                if (g_phase == PHASE_PAUSED)
                    g_pauseAccum += (time_t)(time(NULL) - g_pauseStart);
                g_phase = PHASE_MENU;
                continue;
            }
        }

        if ((GetAsyncKeyState('R') & 0x8000) && g_phase != PHASE_MENU && g_phase != PHASE_LEADERBOARD) {
            Sleep(160);
            if (g_phase == PHASE_PAUSED)
                g_pauseAccum += (time_t)(time(NULL) - g_pauseStart);
            InitGame();
            g_phase = PHASE_PLAYING;
        }

        if (GetAsyncKeyState('P') & 0x8000) {
            Sleep(160);
            if (g_phase == PHASE_PLAYING) {
                g_phase = PHASE_PAUSED;
                g_pauseStart = time(NULL);
            } else if (g_phase == PHASE_PAUSED) {
                g_pauseAccum += (time_t)(time(NULL) - g_pauseStart);
                g_phase = PHASE_PLAYING;
            }
        }

        if ((GetAsyncKeyState('H') & 0x8000) && g_phase == PHASE_PLAYING) {
            Sleep(160);
            ActivateHint();
        }

        // -------- 鼠标轮询机制 --------
        while (MouseHit()) {
            MOUSEMSG m = GetMouseMsg();
            g_mouseX = m.x;  g_mouseY = m.y;

            if (m.uMsg == WM_LBUTTONDOWN) {
                if (g_phase == PHASE_MENU) {
                    int btnW = 230, btnH = 50;
                    int btnX = (WIN_W - btnW) / 2;
                    int btnY0 = 155, gap = 15;

                    if (IsInRect(m.x, m.y, btnX, btnY0, btnW, btnH)) {
                        g_diff = DIFF_EASY; g_rows = 3; g_cols = 3; g_total = 9;  g_pairs = 4;
                        InitGame(); g_phase = PHASE_PLAYING;
                    } else if (IsInRect(m.x, m.y, btnX, btnY0 + (btnH + gap), btnW, btnH)) {
                        g_diff = DIFF_MED;  g_rows = 4; g_cols = 4; g_total = 16; g_pairs = 8;
                        InitGame(); g_phase = PHASE_PLAYING;
                    } else if (IsInRect(m.x, m.y, btnX, btnY0 + 2 * (btnH + gap), btnW, btnH)) {
                        g_diff = DIFF_HARD; g_rows = 5; g_cols = 5; g_total = 25; g_pairs = 12;
                        InitGame(); g_phase = PHASE_PLAYING;
                    } else if (IsInRect(m.x, m.y, btnX, btnY0 + 3 * (btnH + gap), btnW, btnH)) {
                        g_phase = PHASE_LEADERBOARD; // 点击进入排行榜页面
                    }

                } else if (g_phase == PHASE_LEADERBOARD) {
                    int btnW = 180, btnH = 45;
                    int btnX = (WIN_W - btnW) / 2;
                    int btnY = WIN_H - 85;
                    if (IsInRect(m.x, m.y, btnX, btnY, btnW, btnH)) {
                        g_phase = PHASE_MENU; // 排行榜点击返回
                    }
                } else if (g_phase == PHASE_PLAYING) {
                    if (g_waitPhase == WAIT_NONE) {
                        int idx = GetCardIdx(m.x, m.y);
                        if (idx >= 0) FlipCard(idx);
                    }
                }
            }
        }
        if (!MouseHit()) GetMousePos(g_mouseX, g_mouseY);

        // -------- 定时匹配核对 --------
        if (g_phase == PHASE_PLAYING &&
            g_waitPhase == WAIT_RESULT &&
            GetTickCount() - g_waitTick >= (DWORD)MATCH_WAIT) {
            CheckMatch();
        }

        if (g_phase == PHASE_PLAYING) UpdateHint();
        if (g_phase == PHASE_WIN) UpdateParticles();

        // -------- 统一状态机视图渲染 --------
        switch (g_phase) {
        case PHASE_MENU:
            DrawMenu(g_mouseX, g_mouseY);
            break;
        case PHASE_PLAYING:
            DrawStatusBar();
            DrawAllCards();
            break;
        case PHASE_PAUSED:
            DrawStatusBar();
            DrawAllCards();
            DrawPauseScreen();
            break;
        case PHASE_WIN:
            DrawStatusBar();
            DrawWinScreen();
            break;
        case PHASE_LEADERBOARD:
            DrawLeaderboardScreen(g_mouseX, g_mouseY);
            break;
        }

        FlushBatchDraw();
        Sleep(16);
    }

    EndBatchDraw();
    closegraph();
    return 0;
}
