void GetMousePos(int& mx, int& my) {
    POINT p = {0};
    HWND hw = (HWND)GetHWnd();
    if (hw && GetCursorPos(&p) && ScreenToClient(hw, &p)) {
        mx = p.x;  my = p.y;
    } else {
